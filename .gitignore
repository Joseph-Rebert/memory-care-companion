data/*.db
output/*
# knowledge_base/index.{npz,json} are intentionally TRACKED — deploys (Render)
# get no VOYAGE_API_KEY at build time, so without the committed index
# load_index() returns None, RAG silently falls back to stuffing all cases, and
# the per-answer sources card never renders. Re-run `build-embeddings` and
# commit the result whenever analysis.jsonl changes.
.env
__pycache__/
*.pyc
.venv/
venv/
!output/.gitkeep

# Editor / OS
.idea/
.DS_Store
**/.DS_Store

# Claude Code / tooling
.claude/

# Backups (analysis.jsonl.bak, index_meta.json.bak.YYYYMMDD, ...)
*.bak
*.bak.*

# Presentation & poster material — not part of the app
*.pptx
*.pdf
poster/
assets/

# Working notes and planning docs — kept locally, not in the repo
FEATURES.md
notes/
Possible Sources.csv
